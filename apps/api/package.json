{
  "name": "@nx-balance/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "API HTTP e worker do NX-Balance (NestJS + Prisma + PostgreSQL).",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.e2e.config.mts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.mts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nx-balance/config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
