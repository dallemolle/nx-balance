# Ambiente de execução: development | test | production.
NODE_ENV=development
# Modo do processo: api (servidor HTTP) | worker (fila pg-boss).
APP_MODE=api
# Porta HTTP da API.
PORT=3000
# Conexão com o PostgreSQL do docker compose (obrigatória).
DATABASE_URL=postgresql://nxbalance:nxbalance@localhost:5432/nxbalance
# Nível de log: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info
# Versão exibida no health check.
APP_VERSION=0.0.0

# ---- Etapas futuras (ainda não validadas) ----
# SMTP do Mailpit para e-mails em desenvolvimento (web em http://localhost:8025).
# SMTP_URL=smtp://localhost:1025
# Endpoint S3 do MinIO (console em http://localhost:9001).
# S3_ENDPOINT=http://localhost:9000
# Bucket criado pelo serviço minio-init.
# S3_BUCKET=nx-balance-dev
# Usuário do MinIO.
# S3_ACCESS_KEY=nxbalance
# Senha do MinIO.
# S3_SECRET_KEY=nxbalance123
